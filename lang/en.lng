# --- Названия этапов (register_stage) ---
_I18N["1. Подготовка системы (FQDN, время, обновления)"]="1. System preparation (FQDN, time, updates)"
_I18N["2. База данных (MariaDB + Redis)"]="2. Database (MariaDB + Redis)"
_I18N["3. Веб-сервер (nginx / Apache)"]="3. Web server (nginx / Apache)"
_I18N["4. PHP (мульти-версии, FPM)"]="4. PHP (multi-version, FPM)"
_I18N["5. Node.js (NodeSource)"]="5. Node.js (NodeSource)"
_I18N["6. phpMyAdmin (веб-админка MariaDB)"]="6. phpMyAdmin (MariaDB web admin)"
_I18N["7. PostgreSQL + pgAdmin"]="7. PostgreSQL + pgAdmin"
_I18N["8. Почта (Postfix + Dovecot)"]="8. Mail (Postfix + Dovecot)"
_I18N["9. Антиспам (Rspamd + ClamAV)"]="9. Antispam (Rspamd + ClamAV)"
_I18N["10. DNS-сервер (BIND)"]="10. DNS server (BIND)"
_I18N["11. FTP + квоты (PureFTPd)"]="11. FTP + quotas (PureFTPd)"
_I18N["12. SSL-сертификаты (Let's Encrypt)"]="12. SSL certificates (Let's Encrypt)"
_I18N["13. Безопасность (firewall, fail2ban, Lynis-аудит)"]="13. Security (firewall, fail2ban, Lynis audit)"
_I18N["14. Мониторинг (Monit, интеграция с ISPConfig)"]="14. Monitoring (Monit, ISPConfig integration)"
_I18N["15. Webmail + статистика (RoundCube)"]="15. Webmail + stats (RoundCube)"
_I18N["16. ISPConfig (панель управления)"]="16. ISPConfig (control panel)"
_I18N["17. LE-сертификат хоста (панель + почта)"]="17. LE host certificate (panel + mail)"
_I18N["18. Плагины ISPConfig для Roundcube (self-service)"]="18. ISPConfig plugins for Roundcube (self-service)"
_I18N["19. Доставляемость почты (TLS + DNS-записи)"]="19. Mail deliverability (TLS + DNS records)"
_I18N["20. Per-domain TLS почты (SNI из Let's Encrypt)"]="20. Per-domain mail TLS (SNI from Let's Encrypt)"
_I18N["21. Авто-тюнинг под железо (MariaDB/PHP/Postfix)"]="21. Auto-tuning for hardware (MariaDB/PHP/Postfix)"
_I18N["22. Резервное копирование (БД + конфиги, cron)"]="22. Backups (DB + configs, cron)"
_I18N["23. Анти-malware (rkhunter + LMD, скан + alert)"]="23. Anti-malware (rkhunter + LMD, scan + alert)"


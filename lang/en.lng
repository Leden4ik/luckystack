# =============================================================================
# English translations for the CLI installer (i18n framework — see lib/i18n.sh).
# Format:  _I18N["<Russian source string>"]="<English translation>"
# The KEY must match the Russian original passed to t() byte-for-byte.
# Untranslated strings simply fall back to Russian — add lines here incrementally.
# =============================================================================

# --- Выбор языка (первый вопрос мастера) ---
_I18N["Язык интерфейса / Interface language"]="Язык интерфейса / Interface language"
_I18N["Русский"]="Russian"
_I18N["English (перевод CLI частичный; панели двуязычны)"]="English (CLI partially translated; web panels are bilingual)"

# --- Анти-malware (D1) ---
_I18N["Анти-malware (rkhunter + Linux Malware Detect)"]="Anti-malware (rkhunter + Linux Malware Detect)"
_I18N["Ежедневный скан на веб-шеллы/малварь по systemd-таймеру + алерт админу."]="Daily scan for web shells / malware via a systemd timer + admin alert."
_I18N["По умолчанию — только оповещение (файлы не трогаем); карантин по желанию."]="By default alert-only (files untouched); quarantine is optional."
_I18N["Что сканировать (пути через пробел)"]="What to scan (space-separated paths)"
_I18N["Время ежедневного скана (ЧЧ:ММ)"]="Daily scan time (HH:MM)"
_I18N["Карантинить находки автоматически? (Нет — только алерт, файлы не трогаем)"]="Quarantine findings automatically? (No — alert only, files untouched)"
_I18N["Карантин перемещает подозрительные файлы — держите бэкапы под рукой (ложные срабатывания)."]="Quarantine moves suspicious files — keep backups handy (false positives)."
_I18N["Использовать движок ClamAV в LMD (точнее, но +RAM/CPU)?"]="Use the ClamAV engine in LMD (more accurate, but +RAM/CPU)?"

# --- Панели-расширения ISPConfig (D3) ---
_I18N["Панели-расширения ISPConfig"]="ISPConfig extension panels"
_I18N["Доп. разделы в панели: бэкап (настройки+запуск+восстановление), уведомления"]="Extra sections in the panel: backup (settings+run+restore), notifications"
_I18N["(email/Telegram), Node.js/Composer по сайтам, CrowdSec, Firewall IP-rules."]="(email/Telegram), per-site Node.js/Composer, CrowdSec, Firewall IP-rules."
_I18N["Все необязательны и не влияют на работу сайтов. Рекомендуется оставить."]="All optional and do not affect site operation. Recommended to keep."
_I18N["Ставить все панели-расширения ISPConfig (рекомендуется)?"]="Install all ISPConfig extension panels (recommended)?"
_I18N["  Composer глобально (для SSH-деплоя в jail'ах и панели по сайтам)?"]="  Composer globally (for SSH deploy in jails and the per-site panel)?"
_I18N["  Панель Node.js/Composer (управление пакетами по сайтам)?"]="  Node.js/Composer panel (per-site package management)?"
_I18N["  Панель уведомлений (email/Telegram из меню ISPConfig)?"]="  Notifications panel (email/Telegram from the ISPConfig menu)?"
_I18N["  Панель бэкапа (настройки + «Бэкап сейчас» + восстановление)?"]="  Backup panel (settings + \"Back up now\" + restore)?"
_I18N["  Панель CrowdSec (баны/метрики/решения в панели)?"]="  CrowdSec panel (bans/metrics/decisions in the panel)?"
_I18N["  Панель «Firewall: блок-лист» (ручной ufw-deny IP/подсетей + подсказки)?"]="  \"Firewall blocklist\" panel (manual ufw-deny for IPs/subnets + suggestions)?"
_I18N["  Панель «Доверенные IP» (белый список для CrowdSec и fail2ban + поиск, где забанен IP)?"]="  \"Trusted IPs\" panel (allowlist for CrowdSec and fail2ban + where-is-this-IP-banned lookup)?"


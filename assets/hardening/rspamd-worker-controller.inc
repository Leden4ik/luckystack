# =============================================================================
# Rspamd controller (web-UI) — задать пароль
# =============================================================================
# Файл: /etc/rspamd/local.d/worker-controller.inc   (rspamd мерджит local.d/)
#
# ВАЖНО: вы проксируете web-UI через /rspamd/ в apps-vhost (порт 3031).
# Без пароля любой, кто знает путь, попадёт в панель Rspamd.
#
# 1) Сгенерировать ХЭШ пароля (не хранить пароль в открытом виде):
#       rspamadm pw
#    введёте пароль — получите строку вида $2$xxxxxxxx...
#
# 2) Вставить хэш ниже в password (и/или enable_password для управления).
# 3) systemctl restart rspamd
# =============================================================================

# Слушать только локально — наружу ходим через nginx /rspamd/ (так и оставить)
bind_socket = "localhost:11334";

# Пароль на просмотр (вставьте свой хэш из `rspamadm pw`)
password = "ВСТАВЬТЕ_ХЭШ_ИЗ_rspamadm_pw";

# Пароль на изменение настроек (можно тот же или отдельный хэш)
enable_password = "ВСТАВЬТЕ_ХЭШ_ИЗ_rspamadm_pw";

# Доверять заголовку X-Forwarded-For от локального nginx (мы за прокси /rspamd/)
secure_ip = "127.0.0.1";
